@startuml mwl_information_model
title Modality Worklist Information Model

hide circle
hide empty members

class "Scheduled Procedure Step\n(Task)" as scheduled_procedure_step

class "Requested Procedure\n(ServiceRequest)" as requested_procedure

class "Imaging Service Request\n(ServiceRequest)" as imaging_service_request

class "Patient" as patient

class "Visit\n(Encounter)" as visit

scheduled_procedure_step "0..n" -- "1" requested_procedure : basedOn >

requested_procedure "0..n" -- "1" imaging_service_request : basedOn >

requested_procedure "0..n" -- "1" visit : encounter >

imaging_service_request "0..n" -- "1" patient : subject >

@enduml
